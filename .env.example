# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda_test

# JWT
JWT_ACCESS_SECRET=super-secret-access-key
JWT_REFRESH_SECRET=super-secret-refresh-key

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000

# Cookie
COOKIE_SECURE=false
REFRESH_TOKEN_TTL_DAYS=7

# Timezone
TZ_CONSULTORIO=America/Guayaquil